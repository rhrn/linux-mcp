# systemd unit for the HTTP transport. Install to /etc/systemd/system/, then:
#   systemctl daemon-reload && systemctl enable --now linux-mcp-http
[Unit]
Description=linux-mcp (MCP over HTTP)
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=mcp
Group=mcp
# Docker access is root-equivalent; drop this line if you use a socket proxy via DOCKER_HOST.
SupplementaryGroups=docker
ExecStart=/usr/local/bin/linux-mcp --http --config /etc/linux-mcp/config.toml
Restart=on-failure
Environment=RUST_LOG=info

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
# systemd creates /var/log/linux-mcp owned by the service user and keeps it writable.
# (A ReadWritePaths= entry that doesn't exist fails the unit with 226/NAMESPACE.)
LogsDirectory=linux-mcp
LogsDirectoryMode=0750
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
# Needed only to bind ports < 1024:
# AmbientCapabilities=CAP_NET_BIND_SERVICE
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
